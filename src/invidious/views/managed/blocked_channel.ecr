<div class="h-box" style="padding: 40px 16px; max-width: 720px; margin: 0 auto; text-align: center;">
    <div style="background: var(--surface-container, #efecf1); border: 1px solid var(--outline-variant); border-radius: var(--radius-card, 16px); padding: 36px 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
        <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(229, 57, 53, 0.12); color: #d32f2f; display: inline-flex; align-items: center; justify-content: center; font-size: 32px; margin-bottom: 16px;">
            <i class="icon ion-ios-lock"></i>
        </div>

        <h2 style="margin: 0 0 8px; font-size: 24px; font-weight: 700; color: var(--text);">Channel Not Permitted</h2>
        <p style="margin: 0 0 20px; font-size: 15px; color: var(--text-secondary); line-height: 1.5;">
            This instance is operating in <strong>Managed Whitelist Mode</strong>. This channel has not been approved by the administrator.
        </p>

        <!-- Channel card preview -->
        <div style="background: var(--surface-container-low, #f5f2f7); border: 1px solid var(--border); border-radius: 12px; padding: 16px; margin-bottom: 24px; display: flex; align-items: center; justify-content: center; gap: 14px;">
            <div style="width: 50px; height: 50px; border-radius: 50%; background: var(--surface-container-highest); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 20px; color: var(--text); flex-shrink: 0;">
                <%= channel.author[0..1].upcase %>
            </div>
            <div style="text-align: left;">
                <div style="font-weight: 700; font-size: 17px; color: var(--text);">
                    <%= HTML.escape(channel.author) %>
                </div>
                <div style="font-size: 12px; color: var(--text-tertiary); font-family: monospace; margin-top: 2px;">
                    UCID: <%= channel.ucid %>
                </div>
            </div>
        </div>

        <!-- Admin quick action -->
        <% if Invidious::Managed::Admin.is_admin?(env) %>
            <div style="background: rgba(11, 87, 208, 0.08); border: 1px solid var(--primary, #0b57d0); border-radius: 10px; padding: 14px; margin-bottom: 20px;">
                <div style="font-size: 13px; font-weight: 700; color: var(--primary, #0b57d0); margin-bottom: 8px;">
                    <i class="icon ion-ios-construct"></i> Administrator Controls
                </div>
                <form action="/admin/whitelist/channel" method="post" style="display: inline;">
                    <input type="hidden" name="channel_input" value="<%= channel.ucid %>">
                    <button type="submit" class="pure-button" style="padding: 8px 18px; border-radius: var(--radius-pill, 9999px); background: var(--primary, #0b57d0); color: #fff; font-size: 14px; font-weight: 600; cursor: pointer;">
                        <i class="icon ion-ios-add"></i> Whitelist Channel (<%= HTML.escape(channel.author) %>)
                    </button>
                </form>
            </div>
        <% end %>

        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <a href="/channels/approved" class="pure-button" style="padding: 10px 20px; border-radius: var(--radius-pill, 9999px); background: var(--primary, #0b57d0); color: #fff; font-weight: 600; font-size: 14px; text-decoration: none;">
                <i class="icon ion-ios-checkmark-circle"></i> Browse Approved Channels
            </a>
            <a href="/" class="pure-button" style="padding: 10px 20px; border-radius: var(--radius-pill, 9999px); background: var(--surface-container-highest); color: var(--text); border: 1px solid var(--border); font-weight: 600; font-size: 14px; text-decoration: none;">
                <i class="icon ion-ios-home"></i> Return to Home
            </a>
        </div>
    </div>
</div>
