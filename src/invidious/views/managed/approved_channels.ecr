<div class="h-box" style="padding: 24px 16px; max-width: 1200px; margin: 0 auto;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--divider);">
        <div>
            <h1 style="margin: 0; font-size: 24px; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 10px;">
                <i class="icon ion-ios-checkmark-circle" style="color: #2e7d32;"></i> Approved Channels Directory
            </h1>
            <p style="margin: 4px 0 0; color: var(--text-secondary); font-size: 14px;">
                Explore all YouTube channels currently authorized on this managed instance.
            </p>
        </div>

        <div>
            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: var(--radius-pill, 9999px); background: var(--surface-container-high); color: var(--text); font-size: 13px; font-weight: 600;">
                <%= channels.size %> Approved Channel<%= channels.size == 1 ? "" : "s" %>
            </span>
        </div>
    </div>

    <% if channels.empty? %>
        <div style="text-align: center; padding: 60px 16px; color: var(--text-secondary);">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--surface-container-highest); display: inline-flex; align-items: center; justify-content: center; font-size: 32px; color: var(--text-tertiary); margin-bottom: 16px;">
                <i class="icon ion-ios-information-circle-outline"></i>
            </div>
            <h3 style="margin: 0 0 8px; font-size: 18px; font-weight: 700; color: var(--text);">No Channels Approved Yet</h3>
            <p style="margin: 0; font-size: 14px; color: var(--text-secondary);">Your administrator has not yet added channels to the whitelist.</p>
        </div>
    <% else %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px;">
            <% channels.each do |c| %>
                <a href="/channel/<%= c.ucid %>" class="pure-button" style="display: flex; align-items: center; gap: 14px; padding: 16px; background: var(--surface-container, #efecf1); border: 1px solid var(--outline-variant); border-radius: var(--radius-card, 16px); text-decoration: none; color: inherit; text-align: left; transition: transform 0.15s ease, box-shadow 0.15s ease;">
                    <div style="width: 48px; height: 48px; border-radius: 50%; background: var(--secondary-container, #e8def8); color: var(--on-secondary-container, #1d192b); font-weight: 700; font-size: 18px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
                        <%= c.name[0..1].upcase %>
                    </div>
                    <div style="min-width: 0; flex: 1;">
                        <div style="font-weight: 700; font-size: 15px; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            <%= HTML.escape(c.name) %>
                        </div>
                        <% if !c.handle.empty? %>
                            <div style="font-size: 12px; color: var(--text-secondary); margin-top: 2px;">
                                <%= HTML.escape(c.handle) %>
                            </div>
                        <% end %>
                        <div style="font-size: 11px; color: #2e7d32; font-weight: 600; margin-top: 4px; display: inline-flex; align-items: center; gap: 4px;">
                            <i class="icon ion-ios-checkmark-circle"></i> Authorized
                        </div>
                    </div>
                </a>
            <% end %>
        </div>
    <% end %>
</div>
