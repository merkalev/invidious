<!DOCTYPE html>
<html lang="en-US">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= I18n.translate(locale, "JavaScript license information") %> - Invidious</title>
    <link rel="stylesheet" href="/css/default.css?v=<%= ASSET_COMMIT %>">
</head>

<body class="no-theme">
    <div class="md-page-container">
        <div class="md-prose-card">
            <h1><%= I18n.translate(locale, "JavaScript license information") %></h1>
            <table id="jslicense-labels1" class="md-table">
                <tr>
                    <td>
                        <a href="/videojs/html/video.js?v=<%= ASSET_COMMIT %>">@videojs/cdn</a>
                    </td>

                    <td>
                        <a href="http://www.apache.org/licenses/LICENSE-2.0">Apache-2.0-only</a>
                    </td>

                    <td>
                        <a href="https://github.com/videojs"><%= I18n.translate(locale, "source") %></a>
                    </td>
                </tr>

                <tr>
                    <td>
                        <a href="/js/sse.js?v=<%= ASSET_COMMIT %>">sse.js</a>
                    </td>

                    <td>
                        <a href="http://www.apache.org/licenses/LICENSE-2.0">Apache-2.0-only</a>
                    </td>

                    <td>
                        <a href="https://github.com/mpetazzoni/sse.js"><%= I18n.translate(locale, "source") %></a>
                    </td>
                </tr>

                <%- {% for row in run("../../../scripts/generate_js_licenses.cr").stringify.split('\n') %} %>
                    <%-= {{row.id}} -%>
                <% {% end %} -%>
            </table>
        </div>
    </div>
</body>
</html>
