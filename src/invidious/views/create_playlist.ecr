<% content_for "header" do %>
<title><%= I18n.translate(locale, "Create playlist") %> - Invidious</title>
<% end %>

<div class="md-auth-wrapper">
    <div class="md-auth-card">
        <div class="md-auth-header">
            <div class="md-auth-icon"><i class="icon ion-ios-list"></i></div>
            <h1><%= I18n.translate(locale, "Create playlist") %></h1>
        </div>

        <form class="pure-form pure-form-stacked md-auth-form" action="/create_playlist?referer=<%= URI.encode_www_form(referer) %>" method="post">
            <fieldset>
                <div class="md-field">
                    <label for="title"><%= I18n.translate(locale, "Title") %></label>
                    <input required id="title" class="pure-input-1" name="title" type="text" placeholder="<%= I18n.translate(locale, "Title") %>">
                </div>

                <div class="md-field">
                    <label for="privacy"><%= I18n.translate(locale, "Playlist privacy") %></label>
                    <select class="pure-input-1" name="privacy" id="privacy">
                        <% PlaylistPrivacy.names.each do |option| %>
                            <option value="<%= option %>" <% if option == "Public" %> selected <% end %>><%= I18n.translate(locale, option) %></option>
                        <% end %>
                    </select>
                </div>

                <button type="submit" name="action" value="create_playlist" class="pure-button pure-button-primary md-auth-submit">
                    <i class="icon ion-md-add"></i>&nbsp;<%= I18n.translate(locale, "Create playlist") %>
                </button>

                <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
            </fieldset>
        </form>
    </div>
</div>
