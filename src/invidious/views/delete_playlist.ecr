<% content_for "header" do %>
<title><%= I18n.translate(locale, "Delete playlist") %> - Invidious</title>
<% end %>

<div class="md-auth-wrapper">
    <form class="pure-form md-dialog-card" action="/delete_playlist?list=<%= plid %>&referer=<%= URI.encode_www_form(referer) %>" method="post">
        <div class="md-dialog-icon md-dialog-danger"><i class="icon ion-ios-trash"></i></div>
        <legend><%= I18n.translate(locale, "Delete playlist `x`?", %|"#{HTML.escape(playlist.title)}"|) %></legend>

        <div class="md-dialog-actions">
            <a class="pure-button pure-button-secondary" href="/playlist?list=<%= plid %>">
                <%= I18n.translate(locale, "No") %>
            </a>
            <button type="submit" name="submit" value="delete_playlist" class="pure-button pure-button-primary">
                <%= I18n.translate(locale, "Yes") %>
            </button>
        </div>

        <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
    </form>
</div>
