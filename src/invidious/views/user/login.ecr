<% content_for "header" do %>
<title><%= I18n.translate(locale, "Log in") %> - Invidious</title>
<% end %>

<div class="md-auth-wrapper">
    <div class="md-auth-card">
        <div class="md-auth-header">
            <img class="md-auth-logo" src="/invidious-colored-vector.svg" alt="Invidious">
            <h1><%= I18n.translate(locale, "Sign In") %> / <%= I18n.translate(locale, "Register") %></h1>
        </div>

        <% case account_type when %>
        <% else # "invidious" %>
            <form class="pure-form pure-form-stacked md-auth-form" action="/login?referer=<%= URI.encode_www_form(referer) %>&type=invidious" method="post">
                <fieldset>
                    <% if email %>
                        <input name="email" type="hidden" value="<%= HTML.escape(email) %>">
                    <% else %>
                        <div class="md-field">
                            <label for="email"><%= I18n.translate(locale, "User ID") %></label>
                            <input required id="email" class="pure-input-1" name="email" type="text" autocomplete="username" placeholder="<%= I18n.translate(locale, "User ID") %>">
                        </div>
                    <% end %>

                    <% if password %>
                        <input name="password" type="hidden" value="<%= HTML.escape(password) %>">
                    <% else %>
                        <div class="md-field">
                            <label for="password"><%= I18n.translate(locale, "Password") %></label>
                            <input required id="password" class="pure-input-1" name="password" type="password" autocomplete="current-password" placeholder="<%= I18n.translate(locale, "Password") %>">
                        </div>
                    <% end %>

                    <% if captcha %>
                        <div class="md-captcha-box">
                            <img src="<%= captcha[:question] %>" alt="CAPTCHA">
                        </div>
                        <% captcha[:tokens].each_with_index do |token, i| %>
                            <input type="hidden" name="token[<%= i %>]" value="<%= HTML.escape(token) %>">
                        <% end %>
                        <div class="md-field">
                            <label for="answer"><%= I18n.translate(locale, "Time (h:mm:ss):") %></label>
                            <input id="answer" class="pure-input-1" name="answer" type="text" placeholder="h:mm:ss">
                        </div>

                        <button type="submit" name="action" value="signin" class="pure-button pure-button-primary md-auth-submit">
                            <%= I18n.translate(locale, "Register") %>
                        </button>
                    <% else %>
                        <button type="submit" name="action" value="signin" class="pure-button pure-button-primary md-auth-submit">
                            <%= I18n.translate(locale, "Sign In") %> / <%= I18n.translate(locale, "Register") %>
                        </button>
                    <% end %>
                </fieldset>
            </form>
        <% end %>
    </div>
</div>
