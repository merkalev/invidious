<% content_for "header" do %>
<title><%= I18n.translate(locale, "Change password") %> - Invidious</title>
<% end %>

<div class="md-auth-wrapper">
    <div class="md-auth-card">
        <div class="md-auth-header">
            <div class="md-auth-icon"><i class="icon ion-ios-lock"></i></div>
            <h1><%= I18n.translate(locale, "Change password") %></h1>
        </div>

        <form class="pure-form pure-form-stacked md-auth-form" action="/change_password?referer=<%= URI.encode_www_form(referer) %>" method="post">
            <fieldset>
                <div class="md-field">
                    <label for="password"><%= I18n.translate(locale, "Password") %></label>
                    <input required id="password" class="pure-input-1" name="password" type="password" autocomplete="current-password" placeholder="<%= I18n.translate(locale, "Password") %>">
                </div>

                <div class="md-field">
                    <label for="new_password[0]"><%= I18n.translate(locale, "New password") %></label>
                    <input required id="new_password[0]" class="pure-input-1" name="new_password[0]" type="password" autocomplete="new-password" placeholder="<%= I18n.translate(locale, "New password") %>">
                </div>

                <div class="md-field">
                    <label for="new_password[1]"><%= I18n.translate(locale, "New password") %></label>
                    <input required id="new_password[1]" class="pure-input-1" name="new_password[1]" type="password" autocomplete="new-password" placeholder="<%= I18n.translate(locale, "New password") %>">
                </div>

                <button type="submit" name="action" value="change_password" class="pure-button pure-button-primary md-auth-submit">
                    <%= I18n.translate(locale, "Change password") %>
                </button>

                <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
            </fieldset>
        </form>
    </div>
</div>
