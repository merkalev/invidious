<% content_for "header" do %>
<title><%= I18n.translate(locale, "Clear watch history") %> - Invidious</title>
<% end %>

<div class="md-auth-wrapper">
    <form class="pure-form md-dialog-card" action="/clear_watch_history?referer=<%= URI.encode_www_form(referer) %>" method="post">
        <div class="md-dialog-icon"><i class="icon ion-ios-trash"></i></div>
        <legend><%= I18n.translate(locale, "Clear watch history?") %></legend>

        <div class="md-dialog-actions">
            <a class="pure-button pure-button-secondary" href="<%= URI.encode_www_form(referer) %>">
                <%= I18n.translate(locale, "No") %>
            </a>
            <button type="submit" name="submit" value="clear_watch_history" class="pure-button pure-button-primary">
                <%= I18n.translate(locale, "Yes") %>
            </button>
        </div>

        <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
    </form>
</div>
