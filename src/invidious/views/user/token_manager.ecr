<% content_for "header" do %>
<title><%= I18n.translate(locale, "Token manager") %> - Invidious</title>
<% end %>

<div class="md-page-container">
    <div class="md-feed-toolbar">
        <h2>
            <i class="icon ion-ios-key"></i>
            <%= I18n.translate_count(locale, "tokens_count", tokens.size, I18n::NumberFormatting::HtmlSpan) %>
        </h2>
        <div class="md-toolbar-actions">
            <a class="pure-button pure-button-secondary" href="/preferences?referer=<%= URI.encode_www_form(referer) %>">
                <i class="icon ion-ios-cog"></i>&nbsp;<%= I18n.translate(locale, "Preferences") %>
            </a>
        </div>
    </div>

    <div class="md-settings-card md-list-card">
        <% tokens.each do |token| %>
            <div class="md-list-row<% if token[:session] == sid %> deleted<% end %>">
                <div class="md-list-row-main">
                    <i class="icon ion-ios-key md-list-avatar-icon"></i>
                    <code class="md-code-inline"><%= token[:session] %></code>
                </div>
                <div class="md-list-row-meta">
                    <span><%= I18n.translate(locale, "`x` ago", recode_date(token[:issued], locale)) %></span>
                </div>
                <div class="md-list-row-actions">
                    <form data-onsubmit="return_false" action="/token_ajax?action=revoke_token&session=<%= token[:session] %>&referer=<%= env.get("current_page") %>" method="post">
                        <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                        <input class="pure-button pure-button-secondary low-profile md-danger-pill" type="submit" data-onclick="revoke_token" data-session="<%= token[:session] %>" value="<%= I18n.translate(locale, "revoke") %>">
                    </form>
                </div>
            </div>
        <% end %>
    </div>
</div>
