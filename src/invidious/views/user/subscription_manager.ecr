<% content_for "header" do %>
<title><%= I18n.translate(locale, "Subscription manager") %> - Invidious</title>
<% end %>

<div class="md-page-container">
    <div class="md-feed-toolbar">
        <h2>
            <i class="icon ion-ios-people"></i>
            <a href="/feed/subscriptions">
                <%= I18n.translate_count(locale, "generic_subscriptions_count", subscriptions.size, I18n::NumberFormatting::HtmlSpan) %>
            </a>
        </h2>
        <div class="md-toolbar-actions">
            <a class="pure-button pure-button-secondary" href="/feed/history">
                <i class="icon ion-ios-time"></i>&nbsp;<%= I18n.translate(locale, "Watch history") %>
            </a>
            <a class="pure-button pure-button-secondary" href="/data_control?referer=<%= URI.encode_www_form(referer) %>">
                <i class="icon ion-ios-swap"></i>&nbsp;<%= I18n.translate(locale, "Import/export") %>
            </a>
        </div>
    </div>

    <div class="md-settings-card md-list-card">
        <% subscriptions.each do |channel| %>
            <div class="md-list-row<% if channel.deleted %> deleted<% end %>">
                <div class="md-list-row-main">
                    <i class="icon ion-ios-person md-list-avatar-icon"></i>
                    <a class="md-list-title" href="/channel/<%= channel.id %>"><%= HTML.escape(channel.author) %></a>
                </div>
                <div class="md-list-row-actions">
                    <form data-onsubmit="return_false" action="/subscription_ajax?action=remove_subscriptions&c=<%= channel.id %>&referer=<%= env.get("current_page") %>" method="post">
                        <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                        <input class="pure-button pure-button-secondary low-profile md-danger-pill" type="submit" data-onclick="remove_subscription" data-ucid="<%= channel.id %>" value="<%= I18n.translate(locale, "unsubscribe") %>">
                    </form>
                </div>
            </div>
        <% end %>
    </div>
</div>
