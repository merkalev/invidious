<%
    invidious_companion_check_id = invidious_companion_encrypt(video.id) if invidious_companion

    # Player mode: live HLS, DASH (adaptive quality menu), or plain <video>
    # (progressive formats / audio-only "listen" mode).
    is_live = false
    if (hls_url = video.hls_manifest_url) && video.live_now && !CONFIG.disabled?("livestreams")
        is_live = true
        hls_url = URI.parse(hls_url).request_target
        hls_url += "?local=true" if params.local || invidious_companion
        if invidious_companion
            sep = hls_url.includes?('?') ? '&' : '?'
            hls_url = invidious_companion.public_url.to_s + hls_url + "#{sep}check=#{invidious_companion_check_id}"
        end
    end

    # Streaming engines play extensionless proxy URLs, so the media type is
    # delivered through the `source` property in assets/js/player.js instead.
    # Enable DASH whenever available (unless audio-only listen mode or disabled)
    # so Video.js 10's quality selector (<media-quality-radio-group>) has all
    # resolutions (144p..2160p/4320p + Auto), mapping legacy quality presets
    # (hd720/medium/small) to initial DASH target resolutions.
    dash_url : String? = nil
    effective_quality_dash = params.quality_dash
    if !is_live && !params.listen && !CONFIG.disabled?("dash") && (params.quality == "dash" || (!audio_streams.empty? && !video_streams.empty?))
        dash_url = "/api/manifest/dash/id/#{video.id}?local=true&unique_res=1"
        dash_url = invidious_companion.public_url.to_s + dash_url +
                    "&check=#{invidious_companion_check_id}" if invidious_companion
        if params.quality != "dash"
            effective_quality_dash = case params.quality
                                     when "hd720"  then "720p"
                                     when "medium" then "360p"
                                     when "small"  then "240p"
                                     else               params.quality_dash
                                     end
        end
    end

    # Build progressive fallback sources in case DASH fails or is disabled
    fmt_stream.reject! { |f| f["itag"] == 17 }
    fmt_stream.sort_by! { |f| params.quality == f["quality"] ? 0 : 1 }
    fallback_sources = fmt_stream.map do |fmt|
        f_url = "/latest_version?id=#{video.id}&itag=#{fmt["itag"]}"
        f_url += "&local=true" if params.local || invidious_companion
        f_url = invidious_companion.public_url.to_s + f_url +
                "&check=#{invidious_companion_check_id}" if invidious_companion
        {
            "src"   => f_url,
            "type"  => fmt["mimeType"].as_s,
            "label" => fmt["quality"]?.try(&.as_s) || fmt["qualityLabel"]?.try(&.as_s) || "360p",
        }
    end

    # Hover thumbnails come from a storyboard served as WebVTT. Live streams
    # don't have storyboards.
    storyboard_url = video.live_now ? nil : "/api/v1/storyboards/#{video.id}?height=90"

    preload = params.preload ? "auto" : "metadata"

    common_media_attrs = [
        "id=\"player\"",
        "class=\"iv-media\"",
        "preload=\"#{preload}\"",
        "playsinline",
        (params.autoplay ? "autoplay" : nil),
        (params.video_loop ? "loop" : nil),
        "poster=\"#{thumbnail}\"",
    ].compact.join(" ")

    # Captions are passed to assets/js/player.js as data, and injected into
    # the media element from there. The preferred language comes first.
    caption_list = (preferred_captions + captions).map do |caption|
        api_captions_url = "/api/v1/captions/#{video.id}?label=#{URI.encode_www_form(caption.name)}"
        api_captions_url = invidious_companion.public_url.to_s + api_captions_url +
                            "&check=#{invidious_companion_check_id}" if invidious_companion
        {
            "label"    => caption.name,
            "language" => caption.language_code,
            "src"      => api_captions_url,
        }
    end
%>
<video-player content-title="<%= HTML.escape(video.title) %>">
    <video-skin
        style="--media-accent-color: var(--accent, #f00); --media-accent-text-color: #fff; --media-border-radius: var(--radius-card, 12px); --media-font-family: 'Roboto', 'Noto Sans', 'Helvetica Neue', Arial, sans-serif;">
        <% if is_live %>
            <hlsjs-video <%= common_media_attrs %>></hlsjs-video>
        <% elsif dash_url %>
            <dash-video <%= common_media_attrs %>>
                <% if storyboard_url %>
                <track kind="metadata" label="thumbnails" src="<%= storyboard_url %>" default>
                <% end %>
            </dash-video>
        <% else %>
            <video <%= common_media_attrs %>>
                <% if params.listen %>
                    <% # default to 128k m4a stream
                       best_m4a_stream_index = 0
                       best_m4a_stream_bitrate = 0
                       audio_streams.each_with_index do |fmt, i|
                         bandwidth = fmt["bitrate"].as_i
                         if (fmt["mimeType"].as_s.starts_with?("audio/mp4") && bandwidth > best_m4a_stream_bitrate)
                           best_m4a_stream_bitrate = bandwidth
                           best_m4a_stream_index = i
                         end
                       end
                    %>
                    <% audio_streams.each_with_index do |fmt, i| %>
                        <% src_url  = "/latest_version?id=#{video.id}&itag=#{fmt["itag"]}"
                           src_url += "&local=true" if params.local || invidious_companion
                           src_url = invidious_companion.public_url.to_s + src_url +
                                       "&check=#{invidious_companion_check_id}" if (invidious_companion)
                        %>
                        <source src="<%= src_url %>" type="<%= HTML.escape(fmt["mimeType"].as_s) %>" label="<%= fmt["bitrate"] %>k" <% if i == best_m4a_stream_index %>selected<% end %>>
                    <% end %>
                <% else %>
                    <% fmt_stream.each_with_index do |fmt, i| %>
                        <% src_url  = "/latest_version?id=#{video.id}&itag=#{fmt["itag"]}"
                           src_url += "&local=true" if params.local || invidious_companion
                           src_url = invidious_companion.public_url.to_s + src_url +
                                       "&check=#{invidious_companion_check_id}" if (invidious_companion)
                        %>
                        <source src="<%= src_url %>" type="<%= HTML.escape(fmt["mimeType"].as_s) %>" label="<%= fmt["quality"] %>" <% if params.quality ? (params.quality == fmt["quality"]) : (i == 0) %>selected<% end %>>
                    <% end %>
                    <% if storyboard_url %>
                    <track kind="metadata" label="thumbnails" src="<%= storyboard_url %>" default>
                    <% end %>
                <% end %>
            </video>
        <% end %>
    </video-skin>
</video-player>

<script id="player_data" type="application/json">
<%
    player_data_json = {
        "aspect_ratio"            => aspect_ratio,
        "title"                   => video.title,
        "description"             => HTML.escape(video.short_description),
        "thumbnail"               => thumbnail,
        "preferred_caption_found" => !preferred_captions.empty?,
        "captions"                => caption_list,
        "effective_quality_dash"  => effective_quality_dash,
        "fallback_sources"        => fallback_sources,
    }
    if hls_url
        player_data_json["hls_url"] = hls_url
    elsif dash_url
        player_data_json["dash_url"] = dash_url
    end
%>
<%= player_data_json.to_pretty_json %>
</script>
<script src="/js/player.js?v=<%= ASSET_COMMIT %>"></script>
