<%
    # Video.js 10 (@videojs/html) — browser-ready bundles, self-hosted under
    # assets/videojs/html/.
    #
    #  - /video.js registers <video-player>, <video-skin> and the skin's UI
    #    elements.
    #  - The matching stylesheet is inlined by the bundle at upgrade time; the
    #    copies linked below style the page before that happens (see the
    #    `global.css` note in the Video.js self-hosting guide).
%>
<link rel="stylesheet" href="/videojs/html/global.css?v=<%= ASSET_COMMIT %>">
<link rel="stylesheet" href="/videojs/html/video.css?v=<%= ASSET_COMMIT %>">
<link rel="stylesheet" href="/css/player.css?v=<%= ASSET_COMMIT %>">

<script type="module" src="/videojs/html/video.js?v=<%= ASSET_COMMIT %>"></script>
<% if (video.hls_manifest_url) && video.live_now && !CONFIG.disabled?("livestreams") %>
    <script type="module" src="/videojs/html/media/hlsjs-video.js?v=<%= ASSET_COMMIT %>"></script>
<% elsif !params.listen && !CONFIG.disabled?("dash") && (params.quality == "dash" || invidious_companion || (!audio_streams.empty? && !video_streams.empty?)) %>
    <script type="module" src="/videojs/html/media/dash-video.js?v=<%= ASSET_COMMIT %>"></script>
<% end %>
