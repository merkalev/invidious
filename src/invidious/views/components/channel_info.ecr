<% if channel.banner %>
    <div class="h-box channel-banner-wrap">
        <img class="channel-banner" src="/ggpht<%= URI.parse(channel.banner.not_nil!.gsub("=w1060-", "=w1280-")).request_target %>" alt="" />
    </div>
<% end %>

<div class="h-box">
    <div class="md-channel-header">
        <div class="md-channel-top">
            <div class="channel-profile md-channel-profile">
                <img src="/ggpht<%= channel_profile_pic %>" alt="" />
                <div class="channel-name-pronouns">
                    <span class="channel-name"><%= author %></span><% if !channel.verified.nil? && channel.verified %>&nbsp;<i class="icon ion ion-md-checkmark-circle"></i><% end %>
                    <% if !channel.pronouns.nil? %><br /><span class="channel-pronouns"><%= channel.pronouns %></span><% end %>
                </div>
            </div>

            <div class="button-container flexible">
                <div class="pure-u">
                    <% sub_count_text = number_to_short_text(channel.sub_count) %>
                    <%= rendered "components/subscribe_widget" %>
                </div>

                <div class="pure-u">
                    <a class="pure-button pure-button-secondary" dir="auto" href="/feed/channel/<%= ucid %>">
                        <i class="icon ion-logo-rss"></i>&nbsp;<%= I18n.translate(locale, "generic_button_rss") %>
                    </a>
                </div>
            </div>
        </div>

        <% if !channel.description_html.blank? %>
            <div class="md-channel-description">
                <div id="descriptionWrapper"><p><span style="white-space:pre-wrap"><%= channel.description_html %></span></p></div>
            </div>
        <% end %>

        <div class="md-channel-links">
            <a class="md-chip-link" href="<%= youtube_url %>"><i class="icon ion-logo-youtube"></i> <%= I18n.translate(locale, "View channel on YouTube") %></a>
            <a class="md-chip-link" href="<%= redirect_url %>"><i class="icon ion-ios-shuffle"></i> <%= I18n.translate(locale, "Switch Invidious Instance") %></a>
        </div>

        <div class="md-channel-nav-bar">
            <div class="channel-tabs">
                <%= Invidious::Frontend::ChannelPage.generate_tabs_links(locale, channel, selected_tab) %>
            </div>

            <% if !sort_options.empty? %>
                <div class="channel-sort-chips">
                    <% sort_options.each do |sort| %>
                        <% if sort_by == sort %>
                            <span class="channel-sort-chip active"><%= I18n.translate(locale, sort) %></span>
                        <% else %>
                            <a class="channel-sort-chip" href="<%= relative_url %>?sort_by=<%= sort %>"><%= I18n.translate(locale, sort) %></a>
                        <% end %>
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
</div>
