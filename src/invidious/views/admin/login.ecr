<div class="pure-g" style="justify-content: center; padding: 40px 16px;">
    <div class="pure-u-1 pure-u-md-12-24 pure-u-lg-8-24" style="background: var(--surface-container, #efecf1); padding: 32px; border-radius: var(--radius-card, 16px); box-shadow: 0 4px 16px rgba(0,0,0,0.08); border: 1px solid var(--outline-variant, #e2dde7);">
        <div style="text-align: center; margin-bottom: 24px;">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 50%; background: var(--secondary-container, #e8def8); color: var(--on-secondary-container, #1d192b); font-size: 28px; margin-bottom: 12px;">
                <i class="icon ion-ios-lock"></i>
            </div>
            <h2 style="margin: 0; font-size: 24px; font-weight: 700; color: var(--text);">Invidious Managed</h2>
            <p style="margin: 6px 0 0; color: var(--text-secondary); font-size: 14px;">Administrator Authentication</p>
        </div>

        <% if error %>
            <div style="background: rgba(229, 57, 53, 0.1); border: 1px solid #e53935; color: #d32f2f; border-radius: 8px; padding: 12px; margin-bottom: 20px; font-size: 14px; text-align: center;">
                <i class="icon ion-ios-alert"></i> <%= HTML.escape(error.to_s) %>
            </div>
        <% end %>

        <% if env.params.query["success"]? %>
            <div style="background: rgba(46, 125, 50, 0.1); border: 1px solid #2e7d32; color: #2e7d32; border-radius: 8px; padding: 12px; margin-bottom: 20px; font-size: 14px; text-align: center;">
                <i class="icon ion-ios-checkmark-circle"></i> <%= HTML.escape(env.params.query["success"].to_s) %>
            </div>
        <% end %>

        <form action="/admin/login" method="post" class="pure-form pure-form-stacked">
            <div style="margin-bottom: 20px;">
                <label for="password" style="font-weight: 600; font-size: 13px; margin-bottom: 6px; color: var(--text);">Admin Master Password</label>
                <input id="password" name="password" type="password" required autofocus style="width: 100%; box-sizing: border-box; padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border); background: var(--bg); color: var(--text); font-size: 15px;" placeholder="Enter admin password">
            </div>

            <button type="submit" class="pure-button" style="width: 100%; padding: 12px; background: var(--primary, #0b57d0); color: #fff; border-radius: var(--radius-pill, 9999px); border: none; font-weight: 600; font-size: 15px; cursor: pointer;">
                <i class="icon ion-ios-log-in"></i> Sign In to Admin Panel
            </button>
        </form>

        <div style="margin-top: 24px; text-align: center; font-size: 12px; color: var(--text-tertiary);">
            Protected instance configuration & content whitelist controls.
        </div>
    </div>
</div>
