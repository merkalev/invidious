<% content_for "header" do %>
<title><%= I18n.translate(locale, "Playlists") %> - Invidious</title>
<% end %>

<%= rendered "components/feed_menu" %>

<div class="h-box">
    <div class="md-feed-toolbar">
        <h2><i class="icon ion-ios-list"></i> <%= I18n.translate(locale, "user_created_playlists", %(<span id="count">#{items_created.size}</span>)) %></h2>
        <div class="md-toolbar-actions">
            <a class="pure-button pure-button-primary" href="/create_playlist?referer=<%= URI.encode_www_form("/feed/playlists") %>">
                <i class="icon ion-md-add"></i>&nbsp;<%= I18n.translate(locale, "Create playlist") %>
            </a>
            <a class="pure-button pure-button-secondary" href="/data_control?referer=<%= URI.encode_www_form("/feed/playlists") %>">
                <i class="icon ion-ios-swap"></i>&nbsp;<%= I18n.translate(locale, "Import/export") %>
            </a>
        </div>
    </div>
</div>

<div class="pure-g">
<% items_created.each do |item| %>
    <%= rendered "components/item" %>
<% end %>
</div>

<div class="h-box" style="margin-top: 16px;">
    <div class="md-feed-toolbar">
        <h2><i class="icon ion-ios-bookmark"></i> <%= I18n.translate(locale, "user_saved_playlists", %(<span id="count">#{items_saved.size}</span>)) %></h2>
    </div>
</div>

<div class="pure-g">
<% items_saved.each do |item| %>
    <%= rendered "components/item" %>
<% end %>
</div>

<script src="/js/watched_indicator.js"></script>
