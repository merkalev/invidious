<% content_for "header" do %>
<meta name="description" content="<%= I18n.translate(locale, "An alternative front-end to YouTube") %>">
<title>
    <% if env.get("preferences").as(Preferences).default_home != "Trending" %>
        <%= I18n.translate(locale, "Trending") %> - Invidious
    <% else %>
        Invidious
    <% end %>
</title>
<% end %>

<%= rendered "components/feed_menu" %>

<div class="h-box md-feed-toolbar">
    <div class="channel-sort-chips">
        <% {"Livestreams", "Gaming"}.each do |option| %>
            <% is_active = (trending_type == option) || (trending_type == "Default" && option == "Livestreams") %>
            <a class="channel-sort-chip <%= "active" if is_active %>" href="/feed/trending?type=<%= option %>&region=<%= region %>">
                <i class="icon <%= option == "Gaming" ? "ion-logo-game-controller-b" : "ion-ios-radio" %>"></i>&nbsp;<%= I18n.translate(locale, option) %>
            </a>
        <% end %>
    </div>
    <% if plid %>
        <a class="md-chip-link" href="/playlist?list=<%= plid %>">
            <i class="icon ion-ios-list"></i>&nbsp;<%= I18n.translate(locale, "View as playlist") %>
        </a>
    <% end %>
</div>

<div class="pure-g">
<% trending.each do |item| %>
    <%= rendered "components/item" %>
<% end %>
</div>

<script src="/js/watched_indicator.js"></script>
